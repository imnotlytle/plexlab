# Copy this to ".env" ON THE NAS (same folder) and paste your Gmail App Password.
# The real .env is gitignored and must never be committed.
#
# A Gmail App Password is NOT your normal password. Generate one at:
#   Google Account > Security > 2-Step Verification (must be ON) > App passwords
# It's 16 characters; paste it here WITHOUT spaces.

DIUN_MAIL_APP_PASSWORD=your16charapppassword
