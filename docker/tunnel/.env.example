# Copy this to ".env" ON THE NAS (same folder) and paste the real token.
# The real .env is gitignored and must never be committed.
#
# Get the token from: Cloudflare Zero Trust > Networks > Tunnels & Mesh >
#   (the "Overseerr" tunnel) > Overview > "Add a connector" > Docker >
#   copy the value after `--token` (starts with eyJ).

CF_TUNNEL_TOKEN=eyJ...REPLACE_ME
