# Copy this to ".env" ON THE NAS (same folder) and fill in real values.
# The real .env is gitignored and must never be committed.

# --- PIA credentials (your Private Internet Access LOGIN, not OpenVPN-specific) ---
PIA_USER=pXXXXXXX
PIA_PASS=your-pia-password

# --- PIA server region ---
# Port forwarding (better torrent connectivity) is NOT supported on US regions.
# Good PF-capable choices near Chicago: "CA Toronto", "CA Montreal".
# If you prefer US speed and don't care about port forwarding, e.g. "US Chicago".
PIA_REGION=CA Toronto

# --- Match the existing qBittorrent so it can read its config ---
PUID=1000
PGID=10
TZ=America/Chicago
